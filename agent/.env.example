# Agent Control Panel - PC Agent
# Service Role Key 는 더 이상 저장하지 않습니다. 대신 /api/agent/auth 에서
# 짧은 수명의 JWT 를 교환해서 사용합니다.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
API_BASE_URL=https://your-web-domain.vercel.app

AGENT_API_KEY=acp_your-api-key
AGENT_USER_ID=uuid-of-the-owner

# opt-in: Claude Code 의 파일 시스템 권한 프롬프트를 건너뜁니다.
# 기본은 비활성. 자동화가 필요할 때만 1 로 설정하세요.
# DANGEROUSLY_SKIP_PERMISSIONS=1

# 작업 타임아웃 (ms) — 기본 5분
# TASK_TIMEOUT_MS=300000
