/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  X-DNS-Prefetch-Control: on
  Permissions-Policy: accelerometer=(), autoplay=(self), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: data:; connect-src 'self' https://unpkg.com https://cdn.jsdelivr.net https://storage.googleapis.com https://api.github.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# hash 가 박힌 immutable 빌드 자산 — 1년 캐시 + immutable
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# SW 는 절대 장기 캐시 금지 — 장기 캐시되면 stamp-sw-version 으로 버전을 올려도
# 브라우저가 옛 sw.js 를 재검증 없이 써 PWA 업데이트 파이프라인이 얼어붙는다.
/sw.js
  Cache-Control: no-cache

# 매니페스트도 항상 재검증 (아이콘·shortcut 변경 즉시 반영)
/manifest.json
  Cache-Control: no-cache
